{
  "name": "@nekoru/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/public.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:contract": "vitest run --passWithNoTests",
    "test:integration": "node src/require-database.ts && vitest run src/persistence.integration.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@nekoru/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10"
  }
}
