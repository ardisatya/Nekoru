{
  "openapi": "3.1.0",
  "info": {
    "title": "Nekoru API",
    "version": "0.0.0-phase0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "pattern": "^(usr|xid|lrn|gol|cur|kc|cnt|cnv|cpk|ast|pol|evr|sch|lpl|spl|prun|ain|sub|evl|evd|mty|dec|abp|afm|arun|rev|app|iss|idem|obx|ibx|evt|job|aud|cor)_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "reason_code"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "live health probe",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "environment": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "environment"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
